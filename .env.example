# Copy to .env for local use. On your host (Render/Railway/etc.) set these in its Environment settings.
NODE_ENV=production
PORT=3000

# Your Netlify site(s), comma-separated, no trailing slash. Example:
ALLOWED_ORIGINS=https://your-site-name.netlify.app

# Admin login (use a long, unique password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-hex-chars-generated-by-the-command-above
JWT_EXPIRES_IN=8h

# Optional: receive a ping (reference + package only, no personal data) when a request arrives
# NOTIFY_WEBHOOK_URL=

# Optional memory caps (data is in-memory only and resets on restart)
MAX_REQUESTS=2000
MAX_REVIEWS=1000
